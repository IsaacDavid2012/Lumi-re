# Lumière Cinema Streaming Environment Variables
# Copy to .env and configure for your deployment

LUMIERE_SITE_NAME=Lumière
LUMIERE_TRUSTED_PROXIES=127.0.0.1,172.16.0.0/12

# Stripe Subscription Configuration (optional)
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_CENTS=3000
STRIPE_CURRENCY=myr

# TMDB API Credentials (optional for live poster enrichment)
TMDB_API_KEY=
TMDB_READ_TOKEN=
